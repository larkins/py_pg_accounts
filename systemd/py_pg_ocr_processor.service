[Unit]
Description=OCR Queue Processor for Receipt Scanning (tesseract pipeline)
After=postgresql.service network-online.target
Wants=postgresql.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
Environment="PATH=%h/py_pg_accounts/venv/bin:/usr/local/bin:/usr/bin:/bin"
# Secrets + service URLs live in ~/.env (DB_*, MAIL_SERVER_API, etc).
# EnvironmentFile= is read after the inline Environment= lines.
EnvironmentFile=-%h/.env
WorkingDirectory=%h/py_pg_accounts
# 2026-08-04: --no-network means tesseract + local regex only. The previous
# vision LLM endpoint is gone; manual review is via the host agent's
# native vision (offline).
ExecStart=%h/py_pg_accounts/venv/bin/python3 %h/py_pg_accounts/processes/ocr_processor.py --config %h/py_pg_accounts/config.yaml --poll-interval 5 --max-attempts 3
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
